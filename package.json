{
  "name": "pelixflix-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx scripts/db-setup.ts",
    "seed": "tsx scripts/seed.ts",
    "db:tmdb-index": "tsx scripts/migrate-tmdb-index.ts",
    "sync:vimeus": "tsx scripts/sync-vimeus.ts",
    "clone:catalog": "tsx scripts/clone-catalog.ts",
    "categories:normalize": "tsx scripts/normalize-categories.ts",
    "categories:backfill": "tsx scripts/backfill-categories-from-tmdb.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "mongoose": "^8.24.4",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
