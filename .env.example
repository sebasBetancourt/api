PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=netflix-reviews-db
# BD separada para los tests de integración (RUN_DB_TESTS=1). Nunca la de producción.
DB_NAME_TEST=pelixflix-test
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
# Recuperación de contraseña: el enlace usa el primer origen de FRONTEND_URL.
PASSWORD_RESET_TTL_MINUTES=30
# Sin SMTP el enlace solo se escribe en los logs fuera de producción; true lo fuerza también en producción.
PASSWORD_RESET_LOG_LINK=false
# Solo para `pnpm categories:backfill`: clave v3 o token de lectura v4 de TMDB. Nunca la subas al repo.
TMDB_API_KEY=
# seed (opcional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
